# ─── Database (MySQL) ────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:password@localhost:3306/repairkl_db"

# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Create DB first: mysql -u root -p -e "CREATE DATABASE repairkl_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://repairkl.com"
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="RepairKL"
NEXT_PUBLIC_CONTACT_PHONE="+601155804809"
NEXT_PUBLIC_CONTACT_EMAIL="hello@repairkl.com"

# ─── SMS (Malaysia) ────────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
# SMS_PROVIDER="twilio"

# ─── Storage ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_STORAGE_URL="https://your-minio-or-s3-bucket"
# STORAGE_BUCKET="repairkl-assets"

# ─── SEO integrations (SEO plan Steps 10–13) ─────────────────────────────────
# All optional and dormant-until-set: with a variable unset, the app renders
# no script, no markup and no link for that feature. Setting the value in
# .env (and redeploying/building) activates it — no code changes needed.

# GA4 measurement ID (Step 10). Activates the gtag script, SPA route tracking
# and the booking/WhatsApp/call/contact events. See src/lib/analytics/.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Google Search Console HTML-tag verification token (Step 11) — the content=
# value only, not the whole <meta> tag. See GSC-SETUP.md.
# NEXT_PUBLIC_GSC_VERIFICATION="abcdefghijklmnopqrstuvwxyz1234567890"

# Google Business Profile (Step 12) — see GBP-PLAYBOOK.md.
# NEXT_PUBLIC_GBP_URL="https://maps.app.goo.gl/xxxxx"          # profile link ("Find us on Google" + JSON-LD sameAs)
# NEXT_PUBLIC_GBP_REVIEW_URL="https://g.page/r/xxxxx/review"   # direct review link (order-complete CTA)
# NEXT_PUBLIC_GBP_PLACE_ID="ChIJxxxxxxxxxxxxxxx"               # place id (live map embed on /contact)

# Social profiles (Step 13) — any profile without a URL stays hidden in the
# nav, footer and Organization JSON-LD.
# NEXT_PUBLIC_SOCIAL_FACEBOOK="https://facebook.com/repairkl"
# NEXT_PUBLIC_SOCIAL_INSTAGRAM="https://instagram.com/repairkl"
# NEXT_PUBLIC_SOCIAL_TWITTER="https://x.com/repairkl"
# NEXT_PUBLIC_SOCIAL_YOUTUBE="https://youtube.com/@repairkl"

# Twitter/X handle incl. the @ (Step 13) — emits twitter:site meta tag.
# NEXT_PUBLIC_TWITTER_HANDLE="@repairkl"
