generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  WORKER
  SUPPORT
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum OtpType {
  PHONE_VERIFY
  EMAIL_VERIFY
  PASSWORD_RESET
  LOGIN
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  WORKER_ASSIGNED
  SERVICE_STARTED
  SERVICE_COMPLETED
  PAYMENT_RECEIVED
  REVIEW_REMINDER
  PROMOTION
  SUPPORT_REPLY
  SYSTEM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

// Section building blocks for DB-driven marketing pages (Step 17 registry
// maps each type to a component + Zod props schema in src/lib/sections/).
enum SectionType {
  HERO
  SERVICE_GRID
  RICH_TEXT
  STATS
  FAQ
  CTA
  TESTIMONIALS
  CONTACT_INFO
  TIMELINE
  VALUES
  IMAGE_TEXT
}

enum NavigationLocation {
  HEADER
  FOOTER
  MOBILE
}

// ─── Users ──────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid()) @db.VarChar(36)
  fullName        String
  email           String    @unique
  phone           String    @unique
  passwordHash    String
  avatarUrl       String?
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  role            UserRole  @default(CUSTOMER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  address         UserAddress?
  otpCodes        OtpCode[]
  bookings        Booking[]          @relation("CustomerBookings")
  reviews         Review[]
  notifications   Notification[]
  savedServices   SavedService[]
  tickets         SupportTicket[]    @relation("CustomerTickets")
  assignedTickets SupportTicket[]    @relation("AgentTickets")
  ticketMessages  TicketMessage[]
  workerProfile   Worker?

  @@map("users")
}

model UserAddress {
  id      String  @id @default(cuid()) @db.VarChar(36)
  userId  String  @unique
  street  String
  city    String
  state   String
  zipCode String
  country String  @default("BD")
  lat     Float?
  lng     Float?
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_addresses")
}

model OtpCode {
  id        String    @id @default(cuid()) @db.VarChar(36)
  userId    String
  code      String
  type      OtpType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

// ─── Workers ───────────────────────────────────────────────────────────────────

model Worker {
  id          String          @id @default(cuid()) @db.VarChar(36)
  userId      String          @unique
  speciality  String
  bio         String?
  rating      Float           @default(0)
  reviewCount Int             @default(0)
  isAvailable Boolean         @default(true)
  isVerified  Boolean         @default(false)
  hourlyRate  Decimal         @db.Decimal(10, 2) @default(0)
  experience  Int             @default(0)
  totalJobs   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments BookingWorker[]
  reviews     Review[]
  earnings    WorkerEarning[]
  schedule    WorkerSchedule[]

  @@map("workers")
}

model WorkerSchedule {
  id        String   @id @default(cuid()) @db.VarChar(36)
  workerId  String
  dayOfWeek Int      // 0=Sun, 6=Sat
  startTime String   // "08:00"
  endTime   String   // "18:00"
  isOff     Boolean  @default(false)
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, dayOfWeek])
  @@map("worker_schedules")
}

model WorkerEarning {
  id        String   @id @default(cuid()) @db.VarChar(36)
  workerId  String
  bookingId String
  amount    Decimal  @db.Decimal(10, 2)
  paidAt    DateTime?
  createdAt DateTime @default(now())
  worker    Worker   @relation(fields: [workerId], references: [id])

  @@map("worker_earnings")
}

// ─── Service Categories ────────────────────────────────────────────────────────

model ServiceCategory {
  id          String    @id @default(cuid()) @db.VarChar(36)
  name        String    @unique
  slug        String    @unique
  description String?
  iconUrl     String?
  color       String    @default("#FD6B22")
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  services    Service[]

  @@map("service_categories")
}

model Service {
  id          String          @id @default(cuid()) @db.VarChar(36)
  categoryId  String
  name        String
  slug        String          @unique
  description String?
  longDesc    String?
  basePrice   Decimal         @default(0) @db.Decimal(10, 2)
  priceUnit   String          @default("fixed")
  imageUrl    String?
  rating      Float           @default(0)
  reviewCount Int             @default(0)
  isActive    Boolean         @default(true)
  isFeatured  Boolean         @default(false)
  duration    Int?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  packages    ServicePackage[]
  bookings    Booking[]
  reviews     Review[]
  savedBy     SavedService[]

  @@map("services")
}

model ServicePackage {
  id          String   @id @default(cuid()) @db.VarChar(36)
  serviceId   String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  includes    Json
  isPopular   Boolean  @default(false)
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_packages")
}

// ─── Bookings ──────────────────────────────────────────────────────────────────

model Booking {
  id            String        @id @default(cuid()) @db.VarChar(36)
  bookingCode   String        @unique
  customerId    String
  serviceId     String
  status        BookingStatus @default(PENDING)
  scheduledDate DateTime
  scheduledTime String
  address       String
  notes         String?
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod String?
  cancelReason  String?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer      User            @relation("CustomerBookings", fields: [customerId], references: [id])
  service       Service         @relation(fields: [serviceId], references: [id])
  workers       BookingWorker[]
  details       BookingDetail?
  payment       Payment?
  review        Review?

  @@map("bookings")
}

model BookingDetail {
  id           String   @id @default(cuid()) @db.VarChar(36)
  bookingId    String   @unique
  houseSize    String?
  furnitures   Json?
  packedBoxes  Int      @default(0)
  workers      Int      @default(1)
  electricians Int      @default(0)
  extraNotes   String?
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_details")
}

model BookingWorker {
  id         String   @id @default(cuid()) @db.VarChar(36)
  bookingId  String
  workerId   String
  assignedAt DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  worker     Worker   @relation(fields: [workerId], references: [id])

  @@unique([bookingId, workerId])
  @@map("booking_workers")
}

model Payment {
  id            String        @id @default(cuid()) @db.VarChar(36)
  bookingId     String        @unique
  amount        Decimal       @db.Decimal(10, 2)
  method        String
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  gateway       String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Review {
  id         String   @id @default(cuid()) @db.VarChar(36)
  customerId String
  serviceId  String
  workerId   String?
  bookingId  String   @unique
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  customer   User     @relation(fields: [customerId], references: [id])
  service    Service  @relation(fields: [serviceId], references: [id])
  worker     Worker?  @relation(fields: [workerId], references: [id])
  booking    Booking  @relation(fields: [bookingId], references: [id])

  @@map("reviews")
}

// ─── Support ───────────────────────────────────────────────────────────────────

model SupportTicket {
  id          String         @id @default(cuid()) @db.VarChar(36)
  customerId  String?
  agentId     String?
  bookingId   String?
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    String?
  guestName   String?
  guestEmail  String?
  guestPhone  String?
  resolvedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  customer    User?           @relation("CustomerTickets", fields: [customerId], references: [id])
  agent       User?           @relation("AgentTickets", fields: [agentId], references: [id])
  messages    TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id        String        @id @default(cuid()) @db.VarChar(36)
  ticketId  String
  senderId  String?
  message   String
  isInternal Boolean      @default(false)
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User?         @relation(fields: [senderId], references: [id])

  @@map("ticket_messages")
}

// ─── Notifications & Promotions ────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid()) @db.VarChar(36)
  userId    String
  title     String
  body      String
  type      NotificationType
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model SavedService {
  id        String   @id @default(cuid()) @db.VarChar(36)
  userId    String
  serviceId String
  savedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
  @@map("saved_services")
}

model Promotion {
  id            String   @id @default(cuid()) @db.VarChar(36)
  code          String   @unique
  title         String
  description   String?
  discountType  String
  discountValue Decimal  @db.Decimal(10, 2)
  minOrderValue Decimal  @default(0) @db.Decimal(10, 2)
  maxDiscount   Decimal? @db.Decimal(10, 2)
  usageLimit    Int?
  usedCount     Int      @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@map("promotions")
}

model Banner {
  id        String   @id @default(cuid()) @db.VarChar(36)
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("banners")
}

// ─── CMS (SEO plan Step 15) ─────────────────────────────────────────────────────
// Data layer only — admin UI arrives in Steps 16–18. Marketing pages keep
// rendering from code until Step 17/18 swap them to these tables.

/// Singleton row (id = 1): site identity every page can rely on. Null fields
/// fall back to the code defaults in src/lib/seo/site.ts, so the admin can
/// adopt the DB values field by field (Step 16 form).
model SiteSetting {
  id           Int      @id @default(1)

  // NAP (name / address / phone)
  siteName     String   @default("RepairKL") @db.VarChar(120)
  tagline      String?  @db.VarChar(191)
  phone        String?  @db.VarChar(30) // E.164, e.g. +601155804809
  phoneDisplay String?  @db.VarChar(60) // e.g. +60 11-5580 4809
  email        String?  @db.VarChar(191)
  addressLine  String?  @db.VarChar(191)
  city         String?  @db.VarChar(120)
  region       String?  @db.VarChar(120)
  postalCode   String?  @db.VarChar(20)
  countryCode  String?  @db.VarChar(2)
  latitude     Float?
  longitude    Float?

  // Opening hours — { days: string[], opens: "08:00", closes: "22:00" }
  openingHours Json?

  // Social + external profiles — [{ platform: string, url: string }]
  socialProfiles Json?

  // Analytics / verification IDs (seeded from the NEXT_PUBLIC_* envs; the
  // admin form in Step 16 shows and edits these)
  gaMeasurementId String? @db.VarChar(60)
  gscVerification String? @db.VarChar(191)
  gbpUrl           String? @db.VarChar(500)
  gbpReviewUrl     String? @db.VarChar(500)
  gbpPlaceId       String? @db.VarChar(191)
  twitterHandle    String? @db.VarChar(60)

  // Defaults
  defaultOgImage String? @db.VarChar(500)
  robotsTxtExtra String? @db.Text

  updatedAt     DateTime @updatedAt

  @@map("site_settings")
}

/// Per-page SEO metadata. pageKey mirrors the PAGE_META registry keys in
/// src/lib/seo/pageMeta.ts ("home", "about", "our-services/fridge-repair"…);
/// that file stays the fallback until pages read from here (Step 18).
model SeoMeta {
  id              String   @id @default(cuid()) @db.VarChar(36)
  pageKey         String   @unique @db.VarChar(191)
  title           String   @db.VarChar(191)
  description     String?  @db.VarChar(320)
  canonical       String?  @db.VarChar(500)
  keywords        Json? // string[]
  robots          Json? // { index, follow, noIndex … } as MetaInput.robots
  og              Json? // { title, description, image }
  twitter         Json? // { card, image }
  schemaType      String?  @db.VarChar(120)
  breadcrumbTitle String?  @db.VarChar(191)
  updatedAt       DateTime @updatedAt

  page            Page?

  @@map("seo_meta")
}

/// A DB-driven marketing page. slug is site-relative without leading slash;
/// the home page uses slug "home". Step 18's catch-all (marketing)/[slug]
/// renders PUBLISHED pages through the section registry.
model Page {
  id          String     @id @default(cuid()) @db.VarChar(36)
  slug        String     @unique @db.VarChar(191)
  title       String     @db.VarChar(191)
  status      PageStatus @default(DRAFT)
  template    String?    @db.VarChar(120)
  // privacy/terms: no delete, no unpublish (Step 18 guard)
  isProtected Boolean    @default(false)
  seoMetaId   String?    @unique @db.VarChar(36)
  seoMeta     SeoMeta?   @relation(fields: [seoMetaId], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  sections    PageSection[]

  @@map("pages")
}

/// One renderable block of a Page, ordered top-to-bottom. props shape is
/// validated per SectionType by the Zod schemas in src/lib/sections/schemas.ts
/// (Step 17); parse failures skip the section, never crash the page.
model PageSection {
  id        String      @id @default(cuid()) @db.VarChar(36)
  pageId    String      @db.VarChar(36)
  page      Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  order     Int         @default(0)
  type      SectionType
  props     Json
  isVisible Boolean     @default(true)
  updatedAt DateTime    @updatedAt

  @@index([pageId, order])
  @@map("page_sections")
}

/// Media library entry. alt is REQUIRED (accessibility + image SEO) — the
/// admin upload form (Step 16) refuses to save without it.
model MediaAsset {
  id           String   @id @default(cuid()) @db.VarChar(36)
  url          String   @db.VarChar(500)
  alt          String   @db.VarChar(500)
  width        Int?
  height       Int?
  focusKeyword String?  @db.VarChar(191)
  uploadedBy   String?  @db.VarChar(36) // User.id, no FK — stays decoupled
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("media_assets")
}

/// Header/footer/mobile menus. items holds MenuItem[] in the shape of
/// src/lib/navigation.ts — the code file stays the fallback until the
/// layouts read from here (Step 18+).
model Navigation {
  id        String             @id @default(cuid()) @db.VarChar(36)
  location  NavigationLocation @unique
  items     Json
  updatedAt DateTime           @updatedAt

  @@map("navigations")
}

/// Managed redirects (e.g. /ac-repair → /our-services/aircond-service).
/// `from`/`to` are site-relative paths; statusCode 301 or 302.
model Redirect {
  id         String   @id @default(cuid()) @db.VarChar(36)
  from       String   @unique @map("from_path") @db.VarChar(500)
  to         String   @db.VarChar(500)
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("redirects")
}
